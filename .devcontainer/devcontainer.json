{
  "name": "DAIR Agentic Coding",
  "image": "ghcr.io/cedanl/dair-agentic-coding:latest",
  "remoteUser": "dev",
  "remoteEnv": {
    "ANTHROPIC_FOUNDRY_API_KEY": "${localEnv:ANTHROPIC_FOUNDRY_API_KEY}"
  },
  "postCreateCommand": "bash .devcontainer/welcome.sh",
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "chat.editing.autoAccept": true,
        "claudeCode.allowDangerouslySkipPermissions": true,
        "livePreview.openPreviewTarget": "External Browser",
        "security.workspace.trust.enabled": false,
        "livePreview.notifyOnOpenLooseFile": false,
        "livePreview.showServerStatusNotifications": false,
        "workbench.startupEditor": "none",
        "workbench.welcomePage.walkthroughs.openOnInstall": false,
        "workbench.tips.enabled": false,
        "extensions.ignoreRecommendations": true,
        "update.showReleaseNotes": false,
        "git.autofetch": false,
        "git.openRepositoryInParentFolders": "never"
      },
      "extensions": [
        "anthropic.claude-code",
        "ms-vscode.live-server"
      ]
    }
  }
}
